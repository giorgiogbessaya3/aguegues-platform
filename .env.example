# Variables d'environnement — Exemple
# Copiez ce fichier en .env.local et remplissez les valeurs

# Supabase — Créez votre projet sur https://supabase.com
# Puis copiez l'URL et la clé anon depuis : Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_URL.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_KEY

# URL de base de votre application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
